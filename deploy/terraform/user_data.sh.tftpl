#!/bin/bash
# CareLoop voice bridge — first-boot bootstrap (Ubuntu 24.04 LTS).
# Terraform template variables use the $${name} form; shell variables use $VAR.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git tar gzip unzip

# AWS CLI v2 (Ubuntu's apt repositories do not ship the CLI package).
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

# Node 20 (NodeSource)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# Caddy static binary (arch-aware) — handles auto-TLS + WebSocket proxy.
ARCH=$(uname -m)
case "$ARCH" in
  x86_64) CADDY_ARCH=amd64 ;;
  aarch64) CADDY_ARCH=arm64 ;;
  *) CADDY_ARCH=amd64 ;;
esac
curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=$${CADDY_ARCH}" -o /usr/bin/caddy
chmod +x /usr/bin/caddy
id caddy >/dev/null 2>&1 || useradd --system --home /var/lib/caddy --shell /usr/sbin/nologin caddy
mkdir -p /etc/caddy /var/lib/caddy

# App user + code
id careloop >/dev/null 2>&1 || useradd --system --home /opt/careloop --shell /usr/sbin/nologin careloop
git clone ${git_repo} /opt/careloop
cd /opt/careloop
npm ci
npm run build

# .env pulled from SSM (kept out of Terraform state)
aws ssm get-parameter --name "${env_param}" --with-decryption --region ${region} \
  --query 'Parameter.Value' --output text > /opt/careloop/.env
chown -R careloop:careloop /opt/careloop

# Caddyfile — TLS + reverse proxy to the bridge on :3000
cat > /etc/caddy/Caddyfile <<EOF
${domain} {
  reverse_proxy localhost:3000
}
EOF
chown -R caddy:caddy /etc/caddy /var/lib/caddy

# systemd: Caddy
cat > /etc/systemd/system/caddy.service <<'EOF'
[Unit]
Description=Caddy
After=network.target
[Service]
User=caddy
Environment=HOME=/var/lib/caddy
ExecStart=/usr/bin/caddy run --config /etc/caddy/Caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
EOF

# systemd: the bridge
cat > /etc/systemd/system/careloop-bridge.service <<'EOF'
[Unit]
Description=CareLoop voice bridge
After=network.target
[Service]
User=careloop
WorkingDirectory=/opt/careloop
ExecStart=/usr/bin/node dist/src/bridge/server.js
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now careloop-bridge caddy
