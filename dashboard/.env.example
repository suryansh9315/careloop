# CareLoop dashboard configuration — LIVE-ONLY.
#
# Sign-in goes through Medplum's own login API (auth/login -> oauth2/token,
# with PKCE) using only the values below. No client secret reaches the browser
# and no server-side setup is needed: codes minted by auth/login are exchanged
# directly, so this works even when the ClientApplication has no registered
# redirect URI.
#
# If you later want Medplum's hosted sign-in page instead (so passwords are
# never typed into CareLoop, and project identity providers such as Google or
# Okta become available), the only change required is on the server: set a
# Redirect URI on the ClientApplication matching this app's origin exactly,
# trailing slash included — e.g. http://localhost:5180/

# Live Medplum config (required)
VITE_MEDPLUM_BASE_URL=https://api.medplum.com/
VITE_MEDPLUM_CLIENT_ID=39cc9acd-fa9e-4e71-84a0-c4d3f13e45ea
VITE_MEDPLUM_PROJECT_ID=f9962201-e43f-4085-a2d0-6b1488c62ee1

# Patient to load (the dashboard renders this patient's plan artifact + feed).
VITE_PATIENT_ID=9d738069-5e76-419d-8466-4db3ee249d8c

# CareLoop bridge backend (intake + outbound calling). Defaults to localhost:8080.
VITE_BRIDGE_URL=http://localhost:8080
