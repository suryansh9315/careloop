# CareLoop dashboard configuration — LIVE-ONLY.
#
# The dashboard authenticates with Medplum SSO (OAuth2 authorization code flow
# with PKCE). "Continue with Medplum" redirects to Medplum's hosted sign-in
# page; the user authenticates there and returns with a short-lived
# authorization code the browser exchanges for tokens. CareLoop never sees the
# user's password, and there is no client secret in the browser.
#
# One-time setup on the Medplum server:
#   1. Create a ClientApplication (Project Admin -> Clients).
#   2. Add this app's redirect URI to it. It must match BYTE FOR BYTE,
#      trailing slash included — OAuth2 compares it exactly:
#        http://localhost:5180/   (local dev)
#        https://your-domain/     (deployed)
#   3. Put that ClientApplication's id in VITE_MEDPLUM_CLIENT_ID below.
#
# Any external identity provider configured on the Medplum project (Google,
# Okta, Azure AD, ...) then works automatically — the hosted page owns that
# choice, so no further change is needed here.

# Live Medplum config (required)
VITE_MEDPLUM_BASE_URL=https://api.medplum.com/
VITE_MEDPLUM_CLIENT_ID=39cc9acd-fa9e-4e71-84a0-c4d3f13e45ea
VITE_MEDPLUM_PROJECT_ID=f9962201-e43f-4085-a2d0-6b1488c62ee1

# Patient to load (the dashboard renders this patient's plan artifact + feed).
VITE_PATIENT_ID=9d738069-5e76-419d-8466-4db3ee249d8c

# CareLoop bridge backend (intake + outbound calling). Defaults to localhost:8080.
VITE_BRIDGE_URL=http://localhost:8080
