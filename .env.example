# ---- CareLoop environment ----
# Copy to .env and fill in. Missing values degrade gracefully to mock mode
# so the offline simulator (npm run simulate) still runs end to end.

# App
PORT=8080
PUBLIC_HOST=                     # e.g. your-tunnel.ngrok.app (no scheme) — used to build the wss:// Stream URL
ORCH_MODE=state                  # prompt | state
TOOL_SHARED_SECRET=dev-secret    # x-internal-secret for tool endpoints
LOG_LEVEL=info                   # debug | info | warn | error

# Medplum (hosted app.medplum.com — client credentials)
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram (Voice Agent)
DEEPGRAM_API_KEY=

# LLM for post-call workers (research + expert panel). LLM_PROVIDER = groq | anthropic
LLM_PROVIDER=groq

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (used only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Moss (semantic retrieval) — @moss-dev/moss SDK (Moss Cloud, no base URL needed).
# Run `npm run moss:index` once to create the index.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=careloop-asthma-kb

# Stedi (eligibility — test mode)
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com
# Eligibility 270/271 — paste a mock example from the Stedi dashboard (Eligibility →
# mock requests) to get a live 271; otherwise coverage stays on the deterministic mock.
STEDI_PAYER_ID=
STEDI_PROVIDER_NPI=1999999984
STEDI_PROVIDER_NAME=CareLoop Clinic
STEDI_SERVICE_TYPE=30
STEDI_SUB_FIRST_NAME=
STEDI_SUB_LAST_NAME=
STEDI_SUB_DOB=
STEDI_SUB_MEMBER_ID=

# Seed identifiers (populated by `npm run seed`, then referenced by the simulator/bridge)
SEED_PATIENT_ID=
SEED_CONDITION_ID=
SEED_APPOINTMENT_ID=
SEED_QUESTIONNAIRE_ID=
